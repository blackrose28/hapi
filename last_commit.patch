+        expect(textMessages[0]).toEqual({ type: 'text', text: 'thinking...' });
+        // Second: the converted rate limit warning (not raw JSON)
+        expect((textMessages[1] as { text: string }).text).toMatch(/^Claude AI usage limit warning\|/);
+    });

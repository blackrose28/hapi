+            asset('tools/archives/ripgrep-arm64-linux.tar.gz', ripgrepArm64Linux),
+            asset('tools/tunwg/tunwg', tunwgArm64Linux)
+        ];
+    }
+
+    if (feature('HAPI_TARGET_LINUX_X64')) {
+        const [
+            { default: difftasticX64Linux },
+            { default: ripgrepX64Linux },

+        version: z.number(),
+        value: z.unknown().nullable()
+    }).nullable()
+})
+
+export type UpdateSessionBody = z.infer<typeof UpdateSessionBodySchema>
+
+export const UpdateMachineBodySchema = z.object({
+    t: z.literal('update-machine'),
+    machineId: z.string(),
+    metadata: z.object({
+        version: z.number(),
+        value: z.unknown()
+    }).nullable(),

+>(({ className, ...props }, ref) => (
+    <DialogPrimitive.Description
+        ref={ref}
+        className={cn('text-sm text-[var(--app-hint)]', className)}
+        {...props}
+    />
+))
+DialogDescription.displayName = 'DialogDescription'

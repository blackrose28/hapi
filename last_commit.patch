+                sendClaudeSessionMessage: (msg: Record<string, unknown>) => { sentMessages.push(msg) },
+                rpcHandlerManager: { registerHandler: () => {} }
+            },
+            addSessionFoundCallback: () => {},
+            removeSessionFoundCallback: () => {},
+            consumeOneTimeFlags: () => {},
+            recordLocalLaunchFailure: () => {}
+        },
+        sentMessages

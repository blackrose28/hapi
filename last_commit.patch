+}
+
+function SendingIcon() {
+    return (
+        <svg className="h-[14px] w-[14px] animate-spin" viewBox="0 0 16 16" fill="none">
+            <circle cx="8" cy="8" r="6" stroke="currentColor" strokeWidth="1.5" opacity="0.3" />
